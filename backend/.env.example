# LLM / RAG Configuration
# --- Gemini File Search (preferred) ---
# Put your REAL key in backend/.env (gitignored), NOT here. This file is a
# committed template — keep it as a placeholder only.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Produced by: python -m scripts.build_file_search_store
# Leave blank to run in inline-catalog mode (no hosted store needed).
GEMINI_FILE_SEARCH_STORE=

# --- Legacy OpenAI (optional fallback) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Vector Store Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment
PINECONE_INDEX_NAME=uwbothell-courses

# Application Configuration
ENVIRONMENT=development
DEBUG=True
API_HOST=localhost
API_PORT=8000

# Data Sources
UW_TIME_SCHEDULE_URL=https://www.bothell.uw.edu/time-schedule/
CACHE_DIR=../data/cache
